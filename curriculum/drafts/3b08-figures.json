" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"377.5\" y=\"108\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">C</text><text x=\"135\" y=\"148\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">Skip</text><rect x=\"190\" y=\"130\" width=\"75\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"227.5\" y=\"151\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">A</text><rect x=\"265\" y=\"130\" width=\"75\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"302.5\" y=\"151\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">C</text><text x=\"25\" y=\"186\" text-anchor=\"start\" font-size=\"15\" fill=\"currentColor\">Exclusive choice</text><rect x=\"170\" y=\"197\" width=\"70\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"205\" y=\"218\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">A</text><rect x=\"240\" y=\"197\" width=\"70\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"275\" y=\"218\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">X</text><rect x=\"310\" y=\"197\" width=\"70\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"345\" y=\"218\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">C</text><text x=\"400\" y=\"217\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">or</text><rect x=\"430\" y=\"197\" width=\"65\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"462.5\" y=\"218\" text-anchor=\"middle\" font-size=\"15\" fill=\"currentColor\">A</text><rect x=\"495\" y=\"197\" width=\"65\" height=\"32\" rx=\"6\" fill=\"var(--panel)\" stroke=\"var(--accent)\" stroke-width=\"2\"/><text x=\"527.5\" y=\"218\" text-a